{
  "expo": {
    "name": "ClearCart",
    "slug": "clearcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "food-recall-tracker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.clearcart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ClearCart uses your camera to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ClearCart uses your camera to identify food products.",
          "photosPermission": "ClearCart uses your photos to identify food products."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ClearCart uses Face ID to sign you in securely."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
