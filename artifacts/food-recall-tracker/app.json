{
  "expo": {
    "name": "Food Recall Tracker",
    "slug": "food-recall-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "food-recall-tracker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Food Recall Tracker uses your camera to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Food Recall Tracker uses your camera to identify food products.",
          "photosPermission": "Food Recall Tracker uses your photos to identify food products."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Food Recall Tracker uses Face ID to sign you in securely."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
