modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cloudflared"]

[userenv]

[userenv.development]
CLOUDFLARE_ACCOUNT_ID = "c70a168a85cea0244952f3742a38a42f"
CLOUDFLARE_TUNNEL_ID = "d9c46cb7-7c48-41cb-a0c1-6f73a6d83c00"
EXPO_PACKAGER_PROXY_URL = "https://expo.clearcart.net"
EXPO_TUNNEL_HOSTNAME = "expo.clearcart.net"
